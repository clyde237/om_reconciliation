# Configuration de l'environnement OM Reconciliation
APP_ENV=development
APP_DEBUG=True
LOG_LEVEL=INFO

# Chemins de données
DATA_INPUT_DIR=data/input
DATA_OUTPUT_DIR=data/output
DATA_TEMPLATES_DIR=data/templates

# Paramètres de rapprochement (Matching)
MATCHING_TOLERANCE_DAYS=3
MATCHING_TOLERANCE_AMOUNT=0.0
MATCHING_FUZZY_THRESHOLD=85

# Paramètres Sage
SAGE_JOURNAL_CODE=BQ_OM
SAGE_GENERAL_ACCOUNT_OM=512000
SAGE_GENERAL_ACCOUNT_ARRHES=419100
SAGE_EXPORT_FORMAT=PNM
